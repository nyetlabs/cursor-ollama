# Address the proxy listens on when running on the host.
# The container image sets :9000. Passing this file with --env-file overrides that.
LISTEN_ADDRESS=127.0.0.1:9000
# Ollama (when not running proxy in a docker container)
OLLAMA_API_ENDPOINT=http://localhost:11434/api
# OR for Ollama (when running proxy in a docker container)
#OLLAMA_API_ENDPOINT=http://host.docker.internal:11434/api
# Used when a chat request does not name a model. Cursor's selection is forwarded.
#DEFAULT_MODEL=deepseek-coder-v2:16b
#DEFAULT_MODEL=qwen2.5-coder:14b
DEFAULT_MODEL=gpt-oss:20b
